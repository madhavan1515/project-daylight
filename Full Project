@st.cache_data
def generate_surface_telemetry() -> pd.DataFrame:
    rng = np.random.default_rng(42)
    sectors = [
        "Sector 01: Old Dulles Airfield",
        "Sector 02: Metro Core Ruins",
        "Sector 03: Fairfax Ridge Outpost",
        "Sector 04: Potomac Exclusion Zone",
        "Sector 05: Blue Ridge Foothills",
    ]
    base_time = datetime.now() - timedelta(hours=24)
    records = []

    for index, sector in enumerate(sectors):
        is_safe = index in (0, 2, 4)
        oxygen = (
            rng.uniform(20.2, 21.0)
            if is_safe
            else rng.uniform(10.5, 13.0)
        )
        toxins = (
            rng.uniform(0.1, 1.2)
            if is_safe
            else rng.uniform(45.0, 90.0)
        )
        radiation = (
            rng.uniform(0.05, 0.2)
            if is_safe
            else rng.uniform(3.5, 6.8)
        )
        payload = (
            f"{sector}|O2:{oxygen:.2f}|Toxin:{toxins:.2f}|"
            f"Rad:{radiation:.2f}"
        )
        payload_hash = hashlib.sha256(payload.encode("utf-8")).hexdigest()

        records.append(
            {
                "Sector": sector,
                "Timestamp": (
                    base_time + timedelta(minutes=index * 30)
                ).strftime("%Y-%m-%d %H:%M"),
                "Oxygen": round(float(oxygen), 2),
                "Toxins_PPM": round(float(toxins), 2),
                "Radiation_mSv": round(float(radiation), 2),
                "Habitability": "SAFE" if is_safe else "HAZARDOUS",
                "Payload_Hash": payload_hash,
                "Directorate_Toxins_PPM": round(float(toxins * 45), 2),
            }
        )

    return pd.DataFrame(records)


def run_pioneer_simulation(
    equipment: str,
    radiation_shielding: int,
    seal_integrity: int,
    exclude_sick: bool,
    sector_safe: bool,
) -> tuple[float, float]:
    rng = np.random.default_rng(101)

    if "Bio-Suits" in equipment:
        base_survival = 0.65
        risk_factor = 0.30
    elif "Domes" in equipment:
        base_survival = 0.82
        risk_factor = 0.15
    else:
        base_survival = 0.95
        risk_factor = 0.05

    modifier = (radiation_shielding * 0.5 + seal_integrity * 0.5) / 100
    success_probability = np.clip(
        base_survival * modifier
        - risk_factor * (1 - modifier)
        + (0.08 if sector_safe else -0.15)
        + (0.04 if exclude_sick else -0.04),
        0.05,
        0.99,
    )
    successful_trials = rng.binomial(1, float(success_probability), 1000)
    survival_rate = float(np.mean(successful_trials) * 100)
    return round(survival_rate, 1), round(float(success_probability) * 100, 1)


@st.cache_data
def generate_pioneer_roster(
    num_members: int,
    exclude_sick: bool,
    prioritize_specialists: bool,
) -> pd.DataFrame:
    rng = np.random.default_rng(202)
    roles = [
        "Atmospheric Engineer",
        "Trauma Medic",
        "Hydro-Botanist",
        "Autonomous Drone Scout",
        "Geological Surveyor",
    ]
    names = [
        "Kaelen Vance",
        "Lyra Chen",
        "Marcus Thorne",
        "Talia Vos",
        "Orion Reed",
        "Serafina Cruz",
        "Jaxen Miller",
        "Nadia Al-Fassi",
        "Darius Cole",
        "Elena Rostova",
    ]

    roster = []
    for index in range(num_members):
        role = (
            roles[index % 3]
            if prioritize_specialists
            else roles[index % len(roles)]
        )
        compromised = bool(rng.choice([True, False], p=[0.35, 0.65]))
        excluded = exclude_sick and compromised
        roster.append(
            {
                "Operative ID": f"OP-{100 + index}",
                "Name": names[index % len(names)],
                "Assigned Specialty": role,
                "Health Status": (
                    "Compromised (Lung Sickness)"
                    if compromised
                    else "Stable"
                ),
                "Screening Result": "Unfit" if excluded else "Optimal",
                "Deployment Notes": (
                    "Deferred pending treatment"
                    if excluded
                    else "Cleared for first wave"
                ),
            }
        )
    return pd.DataFrame(roster)


def run_evacuation_simulation(
    population_millions: float,
    daily_capacity_thousands: int,
    expansion_rate: int,
    strategy: str,
    acclimation_buffer: bool,
    pioneer_survival: float,
) -> pd.DataFrame:
    total_population = population_millions * 1_000_000
    daily_rate = daily_capacity_thousands * 1000

    if "Medical" in strategy:
        lag = 15
    elif "Infrastructure" in strategy:
        lag = 5
    else:
        lag = 10
    if acclimation_buffer:
        lag += 3

    readiness = float(np.clip(pioneer_survival / 85, 0.6, 1.15))
    evacuated = 0.0
    records = []

    for day in range(1, 181):
        if day < lag:
            effective_rate = daily_rate * 0.2 * readiness
        else:
            multiplier = 1 + ((day - lag) / 30) * (expansion_rate * 0.05)
            effective_rate = min(
                daily_rate * multiplier * readiness,
                total_population * 0.03,
            )

        evacuated = min(evacuated + effective_rate, total_population)
        records.append(
            {
                "Day": day,
                "Evacuated Population": round(evacuated),
                "Percent Complete": round((evacuated / total_population) * 100, 2),
            }
        )

    return pd.DataFrame(records)


